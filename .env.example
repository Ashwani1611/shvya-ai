DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_CONN_MAX_AGE=60
REDIS_URL=
JWT_SECRET=
OPENAI_API_KEY=

# Fallback model for any generative AI task without a more specific override.
OPENAI_AI_MODEL=gpt-4.1-nano
# Customer-facing AI engagement and Playground.
OPENAI_ENGAGEMENT_MODEL=gpt-4.1-nano
# Internal lead qualification generation.
OPENAI_QUALIFICATION_MODEL=gpt-4.1-nano
# Internal conversation summary generation.
OPENAI_SUMMARY_MODEL=gpt-4.1-nano
# Knowledge Base indexing and semantic retrieval embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# One retry owner: OpenAI SDK retries are disabled; Celery owns the max-3 retry
# policy for transient failures. Tighter output caps reduce cost while leaving
# enough room for concise WhatsApp replies plus validated CRM actions.
OPENAI_TIMEOUT_SECONDS=20
# Includes the full JSON decision, qualification evidence, and CRM actions.
# Structured engagement enforces at least 700 tokens (1400 for its one repair).
OPENAI_ENGAGEMENT_MAX_OUTPUT_TOKENS=700
OPENAI_QUALIFICATION_MAX_OUTPUT_TOKENS=500
OPENAI_INTERNAL_SUMMARY_MAX_OUTPUT_TOKENS=300

# Customer-turn debounce for both Meta API and Hosted WhatsApp.
AI_ENGAGEMENT_DEBOUNCE_SECONDS=5
# Approximate character budget for recent chat sent to the engagement model.
# Rolling summary carries older context, so long conversations do not grow the
# prompt without bound.
AI_ENGAGEMENT_CONTEXT_MAX_CHARS=6000
# Background summary/qualification runs when either enough messages OR enough
# substantive new text has accumulated.
AI_ENRICHMENT_MESSAGE_INTERVAL=6
AI_ENRICHMENT_CHAR_INTERVAL=2400

# ============================================================
# SHVYA AI Credits (internal organization wallet)
# ============================================================
# AI credits are NOT OpenAI account credits and are NOT assigned from SHVYA
# packages/plans. Every organization starts at 0 and Superadmin adds credits
# manually. These settings only control how provider token usage converts into
# SHVYA internal AI credits.
AI_CREDIT_RESERVED_OUTPUT_TOKENS=1000
AI_CREDIT_MODEL_RATES_JSON={"gpt-4.1-nano":{"input_per_1k":1,"output_per_1k":4},"text-embedding-3-small":{"input_per_1k":1,"output_per_1k":0}}

# ============================================================
# WhatsApp (Meta)
# ============================================================
# META_VERIFY_TOKEN: a shared secret you choose yourself (any
#   random string) -- enter this SAME value in Meta App Dashboard
#   > WhatsApp > Configuration > Webhook > Verify Token.
# META_APP_SECRET: App Dashboard > Settings > Basic > "App Secret".
#   Used to verify inbound webhook signatures.
# META_APP_ID: App Dashboard > Settings > Basic > "App ID". Public
#   -- sent to the browser to load the embedded signup popup.
# META_WA_EMBEDDED_SIGNUP_CONFIG_ID: App Dashboard > WhatsApp >
#   Configuration > Embedded Signup -- create a "Configuration"
#   there. Without this (and META_APP_ID), the "Connect WhatsApp
#   Now" button won't appear at all -- the Connect API page falls
#   back to the manual phone_number_id / access_token form only.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_WA_EMBEDDED_SIGNUP_CONFIG_ID=

# ============================================================
# WhatsApp (Hosted linked-device gateway)
# ============================================================
# Generate two long random values for production. The gateway is only exposed
# on the Compose network; these secrets authenticate Django -> gateway and
# gateway -> Django callbacks respectively.
WHATSAPP_WEB_GATEWAY_URL=http://whatsapp-web-gateway:3000
WHATSAPP_WEB_GATEWAY_TOKEN=
WHATSAPP_WEB_CALLBACK_TOKEN=
WHATSAPP_WEB_SESSION_PATH=/data/wwebjs_auth

SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
