DEBUG=
SECRET_KEY=
ALLOWED_HOSTS=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_USE_PGBOUNCER=True
# Transaction pooling requires short-lived Django connections and disabled
# server-side cursors (configured automatically when this is True).
DB_CONN_MAX_AGE=0
PGBOUNCER_MAX_CLIENT_CONN=500
PGBOUNCER_DEFAULT_POOL_SIZE=40
PGBOUNCER_RESERVE_POOL_SIZE=10
PGBOUNCER_MAX_DB_CONNECTIONS=60
REDIS_URL=
# Production derives cache=/0, Channels=/1, Celery broker=/2 and Celery
# results=/3. The Hosted gateway uses /4 in Compose. Each URL can be moved to
# a separate Redis service later without application changes.
CACHE_REDIS_URL=
CHANNEL_LAYER_REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
JWT_SECRET=
CREDENTIAL_ENCRYPTION_KEY=
CREDENTIAL_ENCRYPTION_KEY_FALLBACKS=
OPENAI_API_KEY=

# Protected operational snapshot at /health/runtime-metrics/. Generate a long
# random value and send it only from the monitoring system.
OBSERVABILITY_TOKEN=
OBSERVABILITY_SLOW_REQUEST_MS=1000
WEBSOCKET_METRIC_STALE_SECONDS=90

# Cross-replica fairness. Zero keeps admission disabled until staging evidence
# and provider quotas establish a safe non-zero value.
TENANT_HTTP_CONCURRENCY_LIMIT=0
AI_ORGANIZATION_STARTS_PER_MINUTE=0
AI_GLOBAL_STARTS_PER_MINUTE=0
# Provider/account fairness stays disabled until staging and contracted quotas
# establish safe non-zero values.
WHATSAPP_ACCOUNT_SENDS_PER_MINUTE=0
WHATSAPP_GLOBAL_SENDS_PER_MINUTE=0
HOSTED_WHATSAPP_ACCOUNT_SENDS_PER_MINUTE=0
HOSTED_WHATSAPP_GLOBAL_SENDS_PER_MINUTE=0
INSTAGRAM_ACCOUNT_REQUESTS_PER_MINUTE=0
INSTAGRAM_GLOBAL_REQUESTS_PER_MINUTE=0
GOOGLE_CALENDAR_ORGANIZATION_REQUESTS_PER_MINUTE=0
GOOGLE_CALENDAR_GLOBAL_REQUESTS_PER_MINUTE=0
EMAIL_ORGANIZATION_SENDS_PER_MINUTE=0
EMAIL_GLOBAL_SENDS_PER_MINUTE=0
PAYMENT_GATEWAY_REQUESTS_PER_MINUTE=0
PAYMENT_PROVIDER_REQUESTS_PER_MINUTE=0

# Bounded incremental Smart Trigger timer scans.
WORKFLOW_TIMER_RULES_PER_PASS=40
WORKFLOW_TIMER_RULES_PER_ORGANIZATION=2
WORKFLOW_TIMER_LEADS_PER_RULE=100

# Process scale knobs. Total potential DB clients must remain below
# PGBOUNCER_MAX_CLIENT_CONN; server connections remain bounded by the pool.
# Replica counts are declarative Compose inputs, so routine deploys preserve
# the intended horizontal fleet shape.
WEB_REPLICAS=1
ASGI_REPLICAS=1
CELERY_GENERAL_REPLICAS=1
CELERY_AI_REALTIME_REPLICAS=1
CELERY_HOSTED_AI_REPLICAS=1
CELERY_CAMPAIGN_REPLICAS=1
CELERY_INGESTION_REPLICAS=1
CELERY_AUTOMATION_REPLICAS=1
GUNICORN_WORKERS=3
CELERY_GENERAL_CONCURRENCY=4
CELERY_AI_REALTIME_CONCURRENCY=2
CELERY_HOSTED_AI_CONCURRENCY=1
CELERY_CAMPAIGN_CONCURRENCY=2
CELERY_INGESTION_CONCURRENCY=1
CELERY_AUTOMATION_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=500
CELERY_WORKER_MAX_MEMORY_PER_CHILD_KB=768000

# ============================================================
# AWS S3 private media storage (Hostinger VPS -> AWS S3)
# ============================================================
# Create a least-privilege IAM user for the VPS. Store the real credentials
# only in the server-side .env; never commit them to Git.
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=shvya-ai
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_MEDIA_PREFIX=production/media
AWS_QUERYSTRING_EXPIRE=900
# Large public marketing binaries are uploaded separately from private media.
AWS_S3_PUBLIC_ASSET_PREFIX=production/media/public-assets
# Production can serve private S3 objects with presigned URLs. A CDN base,
# when configured, takes precedence and removes signed query strings.
USE_S3_PUBLIC_ASSETS=False
AWS_PUBLIC_ASSET_QUERYSTRING_EXPIRE=86400
PUBLIC_ASSET_BASE_URL=

# Fallback model for any generative AI task without a more specific override.
OPENAI_AI_MODEL=gpt-4.1-nano
# Customer-facing AI engagement and Playground.
OPENAI_ENGAGEMENT_MODEL=gpt-4.1-nano
# Internal lead qualification generation.
OPENAI_QUALIFICATION_MODEL=gpt-4.1-nano
# Internal conversation summary generation.
OPENAI_SUMMARY_MODEL=gpt-4.1-nano
# Knowledge Base indexing and semantic retrieval embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# One retry owner: OpenAI SDK retries are disabled; Celery owns the max-3 retry
# policy for transient failures. Tighter output caps reduce cost while leaving
# enough room for concise WhatsApp replies plus validated CRM actions.
OPENAI_TIMEOUT_SECONDS=20
# Includes the full JSON decision, qualification evidence, and CRM actions.
# Structured engagement enforces at least 700 tokens (1400 for its one repair).
OPENAI_ENGAGEMENT_MAX_OUTPUT_TOKENS=700
OPENAI_QUALIFICATION_MAX_OUTPUT_TOKENS=500
OPENAI_INTERNAL_SUMMARY_MAX_OUTPUT_TOKENS=300

# Short quiet-window that coalesces rapid customer messages into the newest
# conversation turn before generation. Keep between 0 and 5 seconds.
AI_TURN_BURST_SECONDS=4
# Backward-compatible debounce fallback used when AI_TURN_BURST_SECONDS is unset.
AI_ENGAGEMENT_DEBOUNCE_SECONDS=4
# Minimum gap between normal AI sends on one WhatsApp sender. This is transport
# pacing, not the inbound aggregation window.
AI_CONVERSATION_SEND_GAP_SECONDS=5
# Simple qualification answers are persisted deterministically, then composed
# naturally by the engagement model.
AI_SIMPLE_QUALIFICATION_COMPOSE_WITH_LLM=1
# Approximate character budget for recent chat sent to the engagement model.
# Rolling summary carries older context, so long conversations do not grow the
# prompt without bound.
AI_ENGAGEMENT_CONTEXT_MAX_CHARS=6000
# Background summary/qualification runs when either enough messages OR enough
# substantive new text has accumulated.
AI_ENRICHMENT_MESSAGE_INTERVAL=6
AI_ENRICHMENT_CHAR_INTERVAL=2400

# ============================================================
# SHVYA AI Credits (internal organization wallet)
# ============================================================
# AI credits are NOT OpenAI account credits and are NOT assigned from SHVYA
# packages/plans. Every organization starts at 0 and Superadmin adds credits
# manually. These settings only control how provider token usage converts into
# SHVYA internal AI credits.
AI_CREDIT_RESERVED_OUTPUT_TOKENS=1000
AI_CREDIT_MODEL_RATES_JSON={"gpt-4.1-nano":{"input_per_1k":1,"output_per_1k":4},"text-embedding-3-small":{"input_per_1k":1,"output_per_1k":0}}

# ============================================================
# Meta (WhatsApp + Instagram professional messaging)
# ============================================================
# META_VERIFY_TOKEN: shared webhook verify token. Configure this exact value in
#   Meta App Dashboard for both /webhooks/whatsapp/ and /webhooks/instagram/.
# META_APP_SECRET / META_APP_ID: generic Meta app credentials used by WhatsApp
#   Embedded Signup and other Facebook/Meta product flows.
#
# IMPORTANT: Instagram API with Instagram Login uses the dedicated Instagram
# App ID and Instagram App Secret shown in Meta App Dashboard under the
# Instagram API setup. Do NOT use the WhatsApp/Facebook META_APP_ID as the
# Instagram OAuth client_id.
#
# Instagram production setup:
#   META_INSTAGRAM_APP_ID: Instagram API > API setup > Instagram App ID
#   META_INSTAGRAM_APP_SECRET: Instagram API > API setup > Instagram App Secret
#   OAuth redirect URL:
#     https://dashboard.shvya-ai.com/dashboard/instagram/connect/return/
#   Webhook callback URL:
#     https://dashboard.shvya-ai.com/webhooks/instagram/
#   Instagram Login permissions:
#     instagram_business_basic
#     instagram_business_manage_messages
#   Subscribe the Instagram webhook product to messages and messaging_postbacks.
#   After OAuth, SHVYA also subscribes the connected IG professional account via
#   /{ig_user_id}/subscribed_apps. Customer accounts require the appropriate
#   Meta access level/App Review and the app must be live for production use.
#
# META_WA_EMBEDDED_SIGNUP_CONFIG_ID: App Dashboard > Facebook Login for Business
#   > Configurations. Create a v4 configuration using the WhatsApp Embedded
#   Signup variation and the required WhatsApp permissions.
META_VERIFY_TOKEN=
META_APP_SECRET=
META_APP_ID=
META_CONVERSIONS_API_VERSION=v26.0
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_WA_EMBEDDED_SIGNUP_CONFIG_ID=

# ============================================================
# WhatsApp (Hosted linked-device gateway)
# ============================================================
# Generate two long random values for production. The gateway is only exposed
# on the Compose network; these secrets authenticate Django -> gateway and
# gateway -> Django callbacks respectively.
WHATSAPP_WEB_GATEWAY_URL=http://whatsapp-web-gateway:3000
# For multiple gateways use a JSON shard map. Existing accounts keep their
# durable shard assignment; rebalancing is an explicit lease-safe operation.
WHATSAPP_WEB_GATEWAYS=
WHATSAPP_WEB_GATEWAY_SHARD=primary
WHATSAPP_WEB_GATEWAY_INSTANCE_ID=
WHATSAPP_WEB_MAX_SESSIONS=50
WHATSAPP_WEB_GATEWAY_TOKEN=
WHATSAPP_WEB_CALLBACK_TOKEN=
WHATSAPP_WEB_SESSION_PATH=/data/wwebjs_auth

# Global CRM signup verification / password-reset mail.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=noreply@shvya.ai
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Legacy SMTP_* names remain accepted in production during migration.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
