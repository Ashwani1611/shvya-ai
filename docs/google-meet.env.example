# Merge into the protected backend .env. Do not commit actual credentials.
# This is OAuth user authorisation, NOT a Google API key.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Off until the dedicated SHVYA Google account is authorised and validated.
GOOGLE_CALENDAR_PLATFORM_ENABLED=false
GOOGLE_CALENDAR_PLATFORM_ACCOUNT_EMAIL=
GOOGLE_CALENDAR_PLATFORM_REFRESH_TOKEN=
# Optional. Blank/primary resolves to ACCOUNT_EMAIL; use a dedicated calendar.
GOOGLE_CALENDAR_PLATFORM_CALENDAR_ID=
