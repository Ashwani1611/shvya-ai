# SHVYA AI staging environment
# Copy to /opt/shvya-ai-staging/.env.staging and replace every change-me value.

APP_ENV=staging
DJANGO_SETTINGS_MODULE=config.settings.staging
DEBUG=False
SECRET_KEY=change-me-staging-django-secret
JWT_SECRET=change-me-staging-jwt-secret
CREDENTIAL_ENCRYPTION_KEY=change-me-staging-credential-secret
CREDENTIAL_ENCRYPTION_KEY_FALLBACKS=
ALLOWED_HOSTS=staging.shvya-ai.com,web
CSRF_TRUSTED_ORIGINS=https://staging.shvya-ai.com

DB_NAME=shvya_staging
DB_USER=shvya_staging
DB_PASSWORD=change-me-staging-db-password
DB_HOST=pgbouncer
DB_PORT=5432
DB_USE_PGBOUNCER=True
DB_CONN_MAX_AGE=0
PGBOUNCER_MAX_CLIENT_CONN=200
PGBOUNCER_DEFAULT_POOL_SIZE=20
PGBOUNCER_RESERVE_POOL_SIZE=5
PGBOUNCER_MAX_DB_CONNECTIONS=30

# AWS S3 private media storage for staging. This can use the same private
# bucket as production while keeping objects isolated under a staging prefix.
# Put the real IAM credentials only in /opt/shvya-ai-staging/.env.staging.
USE_S3_STORAGE=True
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=shvya-ai
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_MEDIA_PREFIX=staging/media
AWS_QUERYSTRING_EXPIRE=900
AWS_S3_PUBLIC_ASSET_PREFIX=staging/media/public-assets
# Leave blank to keep the checked-in static fallback until migration is verified.
PUBLIC_ASSET_BASE_URL=

# One Redis server, separate logical databases per concern.
REDIS_URL=redis://redis:6379/0
CACHE_REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/2
CELERY_RESULT_BACKEND=redis://redis:6379/3

OBSERVABILITY_TOKEN=change-me-staging-observability-token
OBSERVABILITY_SLOW_REQUEST_MS=1000
TENANT_HTTP_CONCURRENCY_LIMIT=0
AI_ORGANIZATION_STARTS_PER_MINUTE=0
AI_GLOBAL_STARTS_PER_MINUTE=0
WHATSAPP_ACCOUNT_SENDS_PER_MINUTE=0
WHATSAPP_GLOBAL_SENDS_PER_MINUTE=0
HOSTED_WHATSAPP_ACCOUNT_SENDS_PER_MINUTE=0
HOSTED_WHATSAPP_GLOBAL_SENDS_PER_MINUTE=0
INSTAGRAM_ACCOUNT_REQUESTS_PER_MINUTE=0
INSTAGRAM_GLOBAL_REQUESTS_PER_MINUTE=0
GOOGLE_CALENDAR_ORGANIZATION_REQUESTS_PER_MINUTE=0
GOOGLE_CALENDAR_GLOBAL_REQUESTS_PER_MINUTE=0
EMAIL_ORGANIZATION_SENDS_PER_MINUTE=0
EMAIL_GLOBAL_SENDS_PER_MINUTE=0
PAYMENT_GATEWAY_REQUESTS_PER_MINUTE=0
PAYMENT_PROVIDER_REQUESTS_PER_MINUTE=0
WORKFLOW_TIMER_RULES_PER_PASS=20
WORKFLOW_TIMER_RULES_PER_ORGANIZATION=2
WORKFLOW_TIMER_LEADS_PER_RULE=50
WEB_REPLICAS=1
ASGI_REPLICAS=1
CELERY_GENERAL_REPLICAS=1
CELERY_AI_REALTIME_REPLICAS=1
CELERY_HOSTED_AI_REPLICAS=1
CELERY_CAMPAIGN_REPLICAS=1
CELERY_INGESTION_REPLICAS=1
CELERY_AUTOMATION_REPLICAS=1
GUNICORN_WORKERS=2
CELERY_GENERAL_CONCURRENCY=2
CELERY_AI_REALTIME_CONCURRENCY=1
CELERY_HOSTED_AI_CONCURRENCY=1
CELERY_CAMPAIGN_CONCURRENCY=1
CELERY_INGESTION_CONCURRENCY=1
CELERY_AUTOMATION_CONCURRENCY=1

OPENAI_API_KEY=
OPENAI_AI_MODEL=gpt-4.1-nano
OPENAI_ENGAGEMENT_MODEL=gpt-4.1-nano
OPENAI_QUALIFICATION_MODEL=gpt-4.1-nano
OPENAI_SUMMARY_MODEL=gpt-4.1-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Use a separate Meta app / test WABA for staging.
META_VERIFY_TOKEN=change-me-staging-meta-verify-token
META_APP_SECRET=
META_APP_ID=
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_WA_EMBEDDED_SIGNUP_CONFIG_ID=

# Hosted WhatsApp gateway must use its own staging secrets/session volume.
WHATSAPP_WEB_GATEWAY_URL=http://whatsapp-web-gateway:3000
WHATSAPP_WEB_GATEWAYS=
WHATSAPP_WEB_GATEWAY_SHARD=primary
WHATSAPP_WEB_GATEWAY_INSTANCE_ID=staging-primary-1
WHATSAPP_WEB_MAX_SESSIONS=25
WHATSAPP_WEB_GATEWAY_TOKEN=change-me-staging-gateway-token
WHATSAPP_WEB_CALLBACK_TOKEN=change-me-staging-callback-token
WHATSAPP_WEB_SESSION_PATH=/data/wwebjs_auth

# Staging is private behind Basic Auth. The deploy workflow generates the
# password on first deploy and stores it only in the server-side .env.staging.
STAGING_BASIC_AUTH_USER=shvya-staging
STAGING_BASIC_AUTH_PASSWORD=change-me-staging-basic-auth-password

# Hard safety controls for WhatsApp API, Hosted WhatsApp and Instagram sends.
# Staging sends nothing by default. To test outbound messaging, explicitly
# enable it and allowlist only test phone numbers / Instagram recipient IDs.
OUTBOUND_MESSAGING_ENABLED=False
STAGING_ALLOWED_RECIPIENTS=

# Email should use a sandbox/test SMTP account in staging.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=staging@shvya-ai.com
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
